<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <!-- Stat row: sleep / reading / budget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg">
            <TextView
                android:id="@+id/sleep_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#818CF8"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/sleep_hours_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0h 00m"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleep Logged"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg">
            <TextView
                android:id="@+id/pages_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#06B6D4"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/pages_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0p"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pages Today"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_card_bg">
            <TextView
                android:id="@+id/spend_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On Track"
                android:textColor="#22C55E"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/spend_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spent Today"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action row: sleep toggle / reading timer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_sleep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_button_bg">
            <TextView
                android:id="@+id/sleep_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Awake"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:gravity="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track Sleep"
                android:textColor="#818CF8"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to log sleep cycle"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_read"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_button_bg">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reading"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:gravity="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reading Timer"
                android:textColor="#06B6D4"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/read_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Idle"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Add expense row -->
    <LinearLayout
        android:id="@+id/btn_expense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_button_bg">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Add Expense"
            android:textColor="#F59E0B"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/spend_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="0%"
            android:textColor="#F59E0B"
            android:textStyle="bold"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/spend_of_budget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="of ₹0.00 budget"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
