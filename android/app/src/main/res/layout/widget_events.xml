<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <!-- Sleep: today's total/goal% merged with the toggle -->
    <LinearLayout
        android:id="@+id/btn_sleep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_button_bg">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sleep_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/widget_ink"
                android:fontFamily="monospace"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/sleep_hours_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0h 00m"
                android:textColor="@color/widget_ink"
                android:fontFamily="monospace"
                android:textSize="16sp" />
            <TextView
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleep logged"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:fontFamily="monospace"
                android:id="@+id/sleep_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Awake"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track sleep"
                android:textColor="@color/widget_ink"
                android:fontFamily="monospace"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reading: pages/goal% merged with the timer -->
    <LinearLayout
        android:id="@+id/btn_read"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_button_bg">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pages_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/widget_ink"
                android:fontFamily="monospace"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/pages_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0p"
                android:textColor="@color/widget_ink"
                android:fontFamily="monospace"
                android:textSize="16sp" />
            <TextView
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pages today"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:fontFamily="monospace"
                android:id="@+id/read_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Idle"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reading timer"
                android:textColor="@color/widget_ink"
                android:fontFamily="monospace"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
