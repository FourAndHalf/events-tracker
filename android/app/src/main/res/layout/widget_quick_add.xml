<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/btn_sleep"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_widget_awake"
        android:contentDescription="Sleep"
        android:scaleType="fitCenter"
        android:padding="10dp"
        android:background="@drawable/widget_button_bg" />

    <ImageView
        android:id="@+id/btn_read"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_widget_read"
        android:contentDescription="Add reading session"
        android:scaleType="fitCenter"
        android:padding="10dp"
        android:background="@drawable/widget_button_bg" />

</LinearLayout>
